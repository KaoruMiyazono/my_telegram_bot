# Telegram Bot Token (from @BotFather)
TG_BOT_TOKEN=your_bot_token_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONTEXT_WINDOW=64000
LLM_OUTPUT_RESERVE=4096
LLM_CONTEXT_SOFT_LIMIT_RATIO=0.74
LLM_CONTEXT_KEEP_RECENT_TOKENS=20000
LLM_COMPACTION_SUMMARY_MAX_TOKENS=8192

# Tool schema projection (M3)
TOOL_INITIAL_MAX_SCHEMAS=8
TOOL_INITIAL_SCHEMA_CHAR_BUDGET=12000
TOOL_SESSION_LRU_SIZE=4

# M8 proactive Agent. Keep disabled/shadow until M9 data sources are configured.
PROACTIVE_ENABLED=false
PROACTIVE_MODE=shadow
PROACTIVE_CHANNEL=telegram
PROACTIVE_CHAT_ID=
PROACTIVE_USER_ID=
PROACTIVE_THRESHOLD=0.6
PROACTIVE_INTERVAL_SECONDS=300
PROACTIVE_BLOCKED_INTERVAL_SECONDS=60
PROACTIVE_EMPTY_INTERVAL_SECONDS=600
PROACTIVE_COOLDOWN_SECONDS=3600
PROACTIVE_DAILY_LIMIT=3
PROACTIVE_QUIET_START_HOUR=22
PROACTIVE_QUIET_END_HOUR=8
PROACTIVE_TIMEZONE=Asia/Shanghai
PROACTIVE_URGENT_BYPASS_BUSY=false
PROACTIVE_URGENT_BYPASS_COOLDOWN=true
PROACTIVE_URGENT_BYPASS_QUIET=true
PROACTIVE_URGENT_BYPASS_DAILY_LIMIT=false
PROACTIVE_SOURCE_CONFIG_PATH=./config/proactive_sources.toml
PROACTIVE_COLD_START_THRESHOLD=0.9
PROACTIVE_INTEREST_MAX_ITEMS=24
PROACTIVE_INTEREST_MAX_CHARS=6000
PROACTIVE_LLM_JUDGE_ENABLED=false
PROACTIVE_CONTENT_DEDUPE_HOURS=168
PROACTIVE_SEMANTIC_DEDUPE_HOURS=24
PROACTIVE_SEMANTIC_SIMILARITY_THRESHOLD=0.88
PROACTIVE_EMPTY_BACKOFF_MULTIPLIER=2.0
PROACTIVE_EMPTY_BACKOFF_MAX_SECONDS=2400
PROACTIVE_ERROR_BACKOFF_BASE_SECONDS=60
PROACTIVE_ERROR_BACKOFF_MAX_SECONDS=1800
PROACTIVE_ALERT_INTERVAL_SECONDS=60
PROACTIVE_SCHEDULE_JITTER_RATIO=0.1
PROACTIVE_ACK_MAX_ATTEMPTS=5
PROACTIVE_ACK_RETRY_BASE_SECONDS=30
PROACTIVE_ACK_RETRY_MAX_SECONDS=3600
PROACTIVE_ACK_WORKER_INTERVAL_SECONDS=30

# Generic MCP runtime (M4). Secret values stay in environment variables and
# mcp_servers.toml references only their names.
MCP_CONFIG_PATH=./config/mcp_servers.toml
MCP_STDIO_COMMAND_ALLOWLIST=python,python3,node,npx,uvx
MCP_CONNECT_TIMEOUT=20
MCP_DRAIN_TIMEOUT=10
MCP_ALLOW_LOOPBACK_HTTP=true

# LangSmith Eval
LANGSMITH_API_KEY=your_langsmith_api_key
# Use https://api.smith.langchain.com for default US SaaS.
# Use https://apac.api.smith.langchain.com if your workspace is on APAC.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Aliyun DashScope (Embedding)
ALIYUN_DASHSCOPE_API_KEY=your_dashscope_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Database
# Local: DATABASE_PATH=./data/memory.db
# Docker: DATABASE_PATH=/app/data/memory.db
DATABASE_PATH=./data/memory.db

# Proxy (needed for Telegram API in China)
# HTTP_PROXY=http://127.0.0.1:7890

# Web search and fetch (Exa public MCP endpoint works without a key for trial use)
WEB_SEARCH_ENDPOINT=https://mcp.exa.ai/mcp
# SEARCH_API_KEY=your_exa_api_key
# WEB_PROXY=socks5://127.0.0.1:7897
WEB_SEARCH_TIMEOUT=25
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_MAX_CHARS=15000
WEB_FETCH_MAX_REDIRECTS=3
