# Telegram Bot Token (from @BotFather)
TG_BOT_TOKEN=your_bot_token_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONTEXT_WINDOW=64000
LLM_OUTPUT_RESERVE=4096

# Tool schema projection (M3)
TOOL_INITIAL_MAX_SCHEMAS=8
TOOL_INITIAL_SCHEMA_CHAR_BUDGET=12000
TOOL_SESSION_LRU_SIZE=4

# LangSmith Eval
LANGSMITH_API_KEY=your_langsmith_api_key
# Use https://api.smith.langchain.com for default US SaaS.
# Use https://apac.api.smith.langchain.com if your workspace is on APAC.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Aliyun DashScope (Embedding)
ALIYUN_DASHSCOPE_API_KEY=your_dashscope_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Database
# Local: DATABASE_PATH=./data/memory.db
# Docker: DATABASE_PATH=/app/data/memory.db
DATABASE_PATH=./data/memory.db

# Proxy (needed for Telegram API in China)
# HTTP_PROXY=http://127.0.0.1:7890

# Web search and fetch (Exa public MCP endpoint works without a key for trial use)
WEB_SEARCH_ENDPOINT=https://mcp.exa.ai/mcp
# SEARCH_API_KEY=your_exa_api_key
# WEB_PROXY=socks5://127.0.0.1:7897
WEB_SEARCH_TIMEOUT=25
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_MAX_CHARS=15000
WEB_FETCH_MAX_REDIRECTS=3
